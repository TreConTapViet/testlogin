# Sao chép file này thành .env rồi điền giá trị (khởi động lại `npm run dev` sau khi sửa).
# Để trống phần Firebase thì app chạy chế độ demo: tài khoản chỉ lưu trên trình duyệt.

# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini. Cách 1 (an toàn): bật Firebase AI Logic trong Console và để trống key.
# Cách 2: điền key từ https://aistudio.google.com/apikey (key sẽ lộ trong code trình duyệt,
# nhớ giới hạn key theo tên miền trong Google Cloud Console).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash

# Không bắt buộc: key của https://www.weatherapi.com
# Để trống thì thanh thời tiết dùng Open-Meteo (miễn phí, không cần key).
VITE_WEATHER_KEY=
